@page
@model NoAccessModel
@{
    ViewData["Title"] = "No access";
}
<div class="card" style="max-width:720px;margin:40px auto">
    <div class="ch"><h2>You don't have access to Azure Quota Reporting</h2></div>
    <div class="cb">
        <p>Your account is signed in but isn't assigned an AQR app role (<code>AQR.Reader</code> or <code>AQR.Admin</code>).</p>
        <p class="note">Ask an AQR administrator to add you, or a group you're in, to the AQR enterprise application in Microsoft Entra ID.</p>
        <a class="btn" href="/.auth/logout">Sign out</a>
    </div>
</div>
