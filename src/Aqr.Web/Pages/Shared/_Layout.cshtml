@using Aqr.Core.Access
@{
    var user = ViewData["User"] as UserContext;
    var vis = ViewData["Visibility"] as Visibility;
    var history = ViewData["HistoryAvailable"] as bool? ?? true;
    var mock = ViewData["UseMock"] as bool? ?? false;
    var asOf = ViewData["AsOf"] as DateTime?;
    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    string Active(string p) => page.Equals(p, StringComparison.OrdinalIgnoreCase) || (p != "/Index" && page.StartsWith(p + "/", StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    var initials = string.Concat((user?.DisplayName ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Azure Quota Reporting</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="topbar">
    <a class="brand" href="/">
        <span class="logo"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg></span>
        Azure Quota Reporting
    </a>
    @if (user is not null)
    {
        <nav class="nav">
            <a class="@Active("/Index")" href="/">Overview</a>
            <a class="@Active("/Explorer")" href="/Explorer">Quota explorer</a>
            <a class="@Active("/Groups")" href="/Groups">Quota groups</a>
            <a class="@Active("/Zones")" href="/Zones">Zones &amp; SKU access</a>
            <a class="@Active("/Trends")" href="/Trends">Trends</a>
            <a class="@Active("/Families")" href="/Families">VM families</a>
            @if (user.IsAdmin) { <a class="@Active("/Admin")" href="/Admin">Admin</a> }
        </nav>
        <div class="right">
            <span>@user.DisplayName · @(user.IsAdmin ? "AQR.Admin" : "AQR.Reader")</span>
            <span class="avatar">@initials</span>
            <a class="signout" href="/.auth/logout">Sign out</a>
        </div>
    }
</header>
@if (mock)
{
    <div class="mockbanner">Synthetic data (Aqr:UseMock = true). Nothing here comes from your Azure tenant.</div>
}
@if (!history)
{
    <div class="mockbanner">In-memory development database: current state only. Point ConnectionStrings:AqrDb at the Azure SQL Database container for history and "as of" reports.</div>
}
@if (asOf is not null)
{
    <div class="mockbanner" style="background:#eef4ff;border-color:#dbe6ff;color:#1e40af">Viewing data <b>as of @asOf.Value.ToString("yyyy-MM-dd HH:mm") UTC</b> (temporal history). <a href="@Context.Request.Path">Back to current</a></div>
}
@if (user is not null && vis is not null && vis.IsEmpty)
{
    <div class="mockbanner" style="background:#fde8e8;border-color:#f5b5b0;color:#b42318">You don't have access to any subscriptions in AQR yet. An AQR administrator grants report visibility by management group, quota group or subscription.</div>
}
@if (user?.GroupsIncomplete == true)
{
    <div class="mockbanner">You're in more groups than your sign-in token can list, and AQR couldn't look them up in Microsoft Graph, so some report access may be missing. Ask an AQR admin to enable the Graph group lookup.</div>
}
<main class="wrap">
    @RenderBody()
    <div class="foot">Azure Quota Reporting · data from Resource Graph QuotaResources, Microsoft.Quota 2025-09-01, Compute Resource SKUs and Subscriptions/locations · <a href="/openapi/v1.json">API</a></div>
</main>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
